class TM {
    static String state = "TAMILNADU";
    String district;
    int n;

    public void set_dimension(String a, int b) {
        district = a;
        n = b;
    }

    public void display() {
        System.out.println("1. PM: " + Common.uni);
        System.out.println("2. CM: ");
        System.out.println("3. STATE: " + state);
        System.out.println("4. District: " + district);
        System.out.println("5. No. of population: " + n);
    }
}

