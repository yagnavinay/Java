public class Main
{
	public static void main(String[] args) {
		boolean f;
		int d,n;
		for (int i=100;i<1000;i++)
		{
		    f=true;
		    n = i;
		    while(n!=0)
		    {
		        d=n%10;
		        if(d!=7&&d!=5&&d!=3&&d!=2)
		        {
		            f=false;
		            break;
		        }
		        n=n/10;
		    }
		    if(f)
		    System.out.println(i);
		}
	}
}
